# Copy to .env.local; connect only a confirmed DEVELOPMENT Supabase project.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project configuration (publishable key is designed to be public)
NEXT_PUBLIC_SUPABASE_URL=PASTE_YOUR_DEVELOPMENT_SUPABASE_PROJECT_URL_HERE
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=PASTE_YOUR_DEVELOPMENT_SUPABASE_PUBLISHABLE_KEY_HERE

# Must match the provider's Email OTP length setting (6-10 digits).
NEXT_PUBLIC_SUPABASE_OTP_LENGTH=6
# OTP uses Supabase dashboard SMTP independently of the worker settings below.

# Phase 4 document transport only. Server-only: NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=PASTE_YOUR_DEVELOPMENT_SUPABASE_SECRET_KEY_HERE

# Approved public canonical origin. Not a credential.
SITE_URL=https://dummyticketonward.com
# Keep false for development/staging. Enable only after launch approval.
SITE_INDEXING_ENABLED=false

# Phase 7 server-only worker. Never use NEXT_PUBLIC_ names for these settings.
# Dedicated restricted worker login, NOT the admin/test DB URL or Supabase API key.
NOTIFICATIONS_DATABASE_URL=PASTE_DEDICATED_WORKER_POSTGRES_CONNECTION_STRING_HERE
NOTIFICATIONS_DATABASE_CA_FILE=PATH_TO_TRUSTED_DATABASE_CA_PEM_IF_REQUIRED
NOTIFICATIONS_APP_ORIGIN=http://localhost:3000
NOTIFICATIONS_TRANSPORT=capture
NOTIFICATIONS_SMTP_MODE=controlled
NOTIFICATIONS_TEST_RECIPIENT=CONTROLLED_RECIPIENT_EMAIL_HERE
NOTIFICATIONS_LIVE_DELIVERY_ENABLED=false
# Temporary development provider. Supabase dashboard SMTP is not reused automatically.
NOTIFICATIONS_SMTP_HOST=smtp.gmail.com
NOTIFICATIONS_SMTP_PORT=465
NOTIFICATIONS_SMTP_USER=DEVELOPMENT_GMAIL_ADDRESS_HERE
NOTIFICATIONS_SMTP_PASSWORD=DEVELOPMENT_GMAIL_APP_PASSWORD_HERE
NOTIFICATIONS_SMTP_FROM=APPROVED_DEVELOPMENT_SENDER_EMAIL_HERE
